# app
PORT=your_port

# Telegram
TELEGRAM_BOT_TOKEN=your_telegram_token

# RabbitMQ
RABBITMQ_URL=your_rabbitmq_url
EXCHANGE_NAME=your_name
QUEUE_NAME=your_queue_name

# routing key used by THIS bot when publishing (worker binds "#" to catch all platforms)
ROUTING_KEY=telegram
BINDING_PATTERN=#

# Storage
EXPORT_FORMAT=csv
DATA_FILE_PATH=your_file_path